# ── Font ───────────────────────────────────────────────────────────────────
font-family = BerkeleyMono Nerd Font
font-size = 14
font-feature = calt
font-feature = liga
font-thicken = true
adjust-cell-height = 10%

# ── Theme ──────────────────────────────────────────────────────────────────
theme = catppuccin-macchiato
background-opacity = 0.9
background-blur-radius = 20

# ── Cursor ─────────────────────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false

# ── Window ─────────────────────────────────────────────────────────────────
window-padding-balance = true
window-save-state = always
window-inherit-working-directory = true
window-decoration = false
gtk-single-instance = true
quit-after-last-window-closed = true
resize-overlay = never

# ── Terminal ───────────────────────────────────────────────────────────────
term = xterm-256color
scrollback-limit = 10000
confirm-close-surface = false

# ── Shell integration ──────────────────────────────────────────────────────
shell-integration = fish
shell-integration-features = no-cursor,sudo,no-title

# ── Mouse ──────────────────────────────────────────────────────────────────
mouse-hide-while-typing = true

# ── macOS ──────────────────────────────────────────────────────────────────
# Option sends Alt, so fzf Alt+C and fish Alt bindings work (ignored on Linux)
macos-option-as-alt = true

# ── Clipboard ──────────────────────────────────────────────────────────────
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow

# ── Keybindings ────────────────────────────────────────────────────────────
# Splits and tabs now live in tmux (prefix C-t, see tmux/.config/tmux), so the
# old ctrl+a leader is gone and C-a is beginning-of-line again in fish/Emacs.
# Let tmux see these instead of Ghostty (swap-window left/right):
keybind = ctrl+shift+left=unbind
keybind = ctrl+shift+right=unbind
